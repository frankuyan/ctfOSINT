# SherlockML Docker Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API Tokens (Required for full functionality)
# =============================================================================

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: read:user, read:org (optional)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twitter/X Bearer Token
# Create at: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# =============================================================================
# Optional Services
# =============================================================================

# Enable Tor proxy for anonymization
TOR_ENABLED=false

# =============================================================================
# Resource Limits (Optional)
# =============================================================================

# Memory limit for SherlockML container
SHERLOCKML_MEMORY_LIMIT=2g

# CPU limit
SHERLOCKML_CPU_LIMIT=1.0
